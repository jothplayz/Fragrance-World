generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Fragrance {
  id             String    @id @default(cuid())
  name           String
  brand          String
  tags           String    @default("[]") // JSON: fresh|citrus|aquatic|floral|woody|amber|gourmand|spicy|green|musk
  occasions      String    @default("[]") // JSON: casual|work|date|formal|evening|sport
  notes          String    @default("")
  fragranticaUrl String    @default("")
  imageUrl       String    @default("")
  seasons        String    @default("[]") // JSON: spring|summer|fall|winter
  enrichmentJson String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  wearLogs       WearLog[]
}

model WearLog {
  id          String    @id @default(cuid())
  fragranceId String
  fragrance   Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)
  wornAt      DateTime  @default(now())
  occasion    String    @default("")

  @@index([fragranceId])
  @@index([wornAt])
}

/// Reference perfumes for local search (seeded JSON + optional Apify URL import). Not the user collection.
model FragranceCatalog {
  id             String   @id @default(cuid())
  name           String
  brand          String
  tags           String   @default("[]")
  seasons        String   @default("[]") // JSON: spring|summer|fall|winter
  notes          String   @default("")
  fragranticaUrl String   @unique
  imageUrl       String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([brand])
}

/// Single-row app settings (id = 1)
model AppSettings {
  id          Int     @id @default(1)
  /// City name for geocoding, e.g. "Paris, France"
  cityQuery   String  @default("")
  latitude    Float?
  longitude   Float?
  displayName String  @default("")
}
