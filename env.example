# SQLite: DATABASE_URL paths are relative to the prisma/ folder (where schema.prisma lives).

# Committed team database (git-tracked at data/shared.db — same data for everyone after pull):
DATABASE_URL=file:../data/shared.db

# Local-only database under prisma/ (gitignored — experiments without changing shared):
# DATABASE_URL=file:./dev.db

# Local-only database at repo root (gitignored):
# DATABASE_URL=file:../dev.db

# Schema migrations against shared: npm run db:push:shared

# Local catalog (FragranceCatalog): after prisma db push, run: npx prisma db seed
# Large catalog (billable Apify runs): npm run catalog:bulk-apify -- --target=10000 --delay-ms=2500
# Import an Apify dataset / run into SQLite: npm run catalog:import-dataset -- <datasetId>
# Optional: APIFY_DATASET_ID=... then npm run catalog:import-dataset

# Apify - Fragrantica import (https://apify.com/lexis-solutions/fragrantica)
APIFY_TOKEN=

# Optional: different actor ID
# APIFY_FRAGRANTICA_ACTOR_ID=lexis-solutions/fragrantica

# Apify Proxy (helps if Fragrantica blocks runs)
# APIFY_USE_PROXY=true

# If set, the API will not automatically retry a failed/empty scrape with Apify proxy (default is one auto-retry).
# APIFY_NO_AUTO_PROXY_RETRY=true

# Collection enrichment (Fragrantica + Wikipedia → detail page panels). Runs async after POST/PATCH when name, brand, or Fragrantica URL changes.
# Backfill: npm run enrich:fragrances -- --all
# One row: npm run enrich:fragrances -- --id=<cuid>  |  Refresh everything: add --force
# Wikipedia uses https://en.wikipedia.org/w/api.php (set a real contact in src/lib/wikipedia-perfume.ts User-Agent if you ship publicly).
